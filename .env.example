DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Set to enabled when you want DeepSeek thinking mode for supported models.
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_JSON_OUTPUT=enabled
DEEPSEEK_MAX_TOKENS=8192

# Local context budget controls.
AGENT_CONTEXT_MAX_FILES=160
AGENT_CONTEXT_SELECTED_MAX_FILES=40
AGENT_CONTEXT_READ_MAX_LENGTH=12000
AGENT_CONTEXT_SEARCH_MAX_FILES=240
AGENT_CONTEXT_SEARCH_MAX_MATCHES=24
AGENT_CONTEXT_TOOL_OUTPUT_MAX_LENGTH=1400

# Local model protocol repair controls.
AGENT_PROTOCOL_REPAIR_MAX_ATTEMPTS=1
AGENT_PROTOCOL_REPAIR_MAX_RAW_LENGTH=2400

# Local tool policy controls.
# Use "all" or a comma-separated allowlist: list_files,read_file,search_text,git_status.
AGENT_ALLOWED_READ_TOOLS=all
# Set to disabled when you want planning-only runs without patchProposal output.
AGENT_PATCH_PROPOSAL=enabled
