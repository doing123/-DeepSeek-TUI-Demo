{
  "name": "deepseek-tui-demo",
  "version": "0.3.0",
  "private": true,
  "description": "A minimal macOS-first coding agent playground built with Next.js, TypeScript, and DeepSeek.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "architecture:generate": "node scripts/generate-architecture-diagram.mjs",
    "docs:generate": "npm run architecture:generate && npm run readme:generate",
    "readme:generate": "node scripts/generate-readme.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "next": "13.5.6",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "@types/react": "18.2.74",
    "@types/react-dom": "18.2.24",
    "typescript": "5.4.5"
  }
}
